{
  "expo": {
    "name": "Kitty Journal",
    "slug": "kitty-journal",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "kittyjournal",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kittyjournal.app"
    },
    "android": {
      "package": "com.kittyjournal.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F0"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kitty Journal needs access to your photos to attach them to entries."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kitty Journal uses your location only when you tap “Use current location”."
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "KittyToday",
              "label": "Kitty Today",
              "description": "Today's date",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "KittyWeek",
              "label": "Kitty Week",
              "description": "Today and this week",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "updatePeriodMillis": 1800000
            },
            {
              "name": "KittyMonth",
              "label": "Kitty Calendar",
              "description": "This month",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "a7200c21-aa4f-4eae-b327-7aacd78f3af9"
      }
    }
  }
}
