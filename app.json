{
  "expo": {
    "name": "Kitty Journal",
    "slug": "kitty-journal",
    "version": "0.2.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "kittyjournal",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kittyjournal.app"
    },
    "android": {
      "package": "com.kittyjournal.app",
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F0"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Kitty Journal needs access to your photos to attach them to entries."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kitty Journal uses your location only when you tap “Use current location”."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "a7200c21-aa4f-4eae-b327-7aacd78f3af9"
      }
    }
  }
}
